<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiTime.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiTime.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarIsVisible="False"
    Shell.NavBarIsVisible="False">

    <TabBar>
        <!-- AÑADIDO: Route="AgendaPage" -->
        <Tab Title="Agenda" Icon="dotnet_bot.png" Route="AgendaPage">
            <ShellContent ContentTemplate="{DataTemplate local:AgendaPage}" />
        </Tab>
        
        <!-- AÑADIDO: Route="CalendarioPage" -->
        <Tab Title="Calendario" Icon="dotnet_bot.png" Route="CalendarioPage">
            <ShellContent ContentTemplate="{DataTemplate local:CalendarioPage}" />
        </Tab>
    </TabBar>

</Shell>
