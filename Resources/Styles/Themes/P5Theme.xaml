<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="P5Red">#E31D26</Color>
    <Color x:Key="P5Black">#000000</Color>
    <Color x:Key="P5White">#FFFFFF</Color>
    <Color x:Key="P5DarkGray">#1A1A1A</Color>

    <x:String x:Key="P5FontFamily">HelveticaNowDisplay-ExtraBold</x:String>

    <Style x:Key="P5EventCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource P5Black}" />
        <Setter Property="Stroke" Value="{StaticResource P5White}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Padding" Value="15" />
        <Setter Property="StrokeShape" Value="Rectangle" /> 
        <Setter Property="Margin" Value="10,5" />
    </Style>

    <Style x:Key="P5TitleStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource P5White}" />
        <Setter Property="FontFamily" Value="{StaticResource P5FontFamily}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Rotation" Value="-5" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BackgroundColor" Value="{StaticResource P5Red}" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style x:Key="P5StickerLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource P5Black}" />
        <Setter Property="BackgroundColor" Value="{StaticResource P5White}" />
        <Setter Property="FontFamily" Value="{StaticResource P5FontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="5,2" />
    </Style>

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource P5DarkGray}" />
    </Style>

</ResourceDictionary>