<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTime.Views.NuevaTareaPopup"
             Title="NUEVO EVENTO PUNK"
             BackgroundColor="#0D0D0D">

        <!-- Canvas Maestro de Capas Gráficas -->
        <Grid>
                <!-- ======================================================================= -->
                <!-- 🎸 DECORACIÓN DEL FONDO GENERAL RECALIBRADA                             -->
                <!-- ======================================================================= -->
                <!-- 1. El gran rayo oblicuo original de tensión -->
                <Path Data="M -50,120 L 900,680 L 1000,600 L -50,40"
                      Fill="#161616"
                      Opacity="0.5"
                      Aspect="Fill"/>

                <!-- 2. Ráfagas de corte secundarias Rojo Fuego en las esquinas -->
                <Polygon Points="0,0 180,0 0,220"
                         Fill="#E31D26"
                         Opacity="0.25"
                         Aspect="Fill"
                         HorizontalOptions="Start"
                         VerticalOptions="Start"/>
                <Polygon Points="620,500 620,700 350,700"
                         Fill="Black"
                         Opacity="0.6"
                         Aspect="Fill"
                         HorizontalOptions="End"
                         VerticalOptions="End"/>

                <!-- 3. LOGO INFERIOR IZQUIERDA: Ajustado con márgenes estrictos para que nunca se corte abajo -->
                <Label Text="MAUITIME"
                       TextColor="#1A1A1A"
                       FontSize="130"
                       FontFamily="Impact"
                       FontAttributes="Bold, Italic"
                       HorizontalOptions="Start"
                       VerticalOptions="End"
                       Margin="15,0,0,15"
                       Rotation="-10"
                       Opacity="0.75"/>

                <!-- 💡 'TAKE YOUR TIME' a la izquierda superior con rotación rebelde -->
                <Label Text="TAKE YOUR TIME"
                       TextColor="#151515"
                       FontSize="42"
                       FontFamily="Impact"
                       FontAttributes="Bold, Italic"
                       HorizontalOptions="Start"
                       VerticalOptions="Start"
                       Margin="30,40,0,0"
                       Rotation="-6"/>

                <!-- REEMPLAZO FIRMA: OPCIÓN 1 (STICKER COLLAGE DUOTONO) -->
                <Grid HorizontalOptions="End"
                      VerticalOptions="End"
                      Margin="0,0,35,35"
                      WidthRequest="130"
                      HeightRequest="50"
                      Rotation="6">
                        <!-- Capa 1: Sombra Sólida Roja Fuego Desplazada -->
                        <Border BackgroundColor="#E31D26"
                                StrokeThickness="0"
                                Margin="5,5,0,0">
                                <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="0"/>
                                </Border.StrokeShape>
                        </Border>
                        <!-- Capa 2: Cuerpo Principal Negro -->
                        <Border BackgroundColor="Black"
                                Stroke="White"
                                StrokeThickness="2"
                                Margin="0,0,5,5">
                                <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="0"/>
                                </Border.StrokeShape>
                        </Border>
                        <!-- Capa 3: Texto de la Firma -->
                        <Label Text="Joker"
                               TextColor="White"
                               FontSize="24"
                               FontFamily="Bubblegum"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0,0,5,5"/>
                </Grid>


                <!-- Contenedor con Scroll para adaptabilidad total de pantallas -->
                <ScrollView VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Margin="15">

                        <!-- Bloque General del HUD (Ancho Rígido 620 Calibrado) -->
                        <Grid WidthRequest="620"
                              RowDefinitions="Auto, *, Auto"
                              Padding="15">

                                <!-- ======================================================================= -->
                                <!-- 👑 CABECERA COLLAGE: TITULAR ESTILO NOTA CORTADA                        -->
                                <!-- ======================================================================= -->
                                <Grid Grid.Row="0"
                                      Rotation="-3.5"
                                      Margin="5,0,0,25"
                                      HorizontalOptions="Start">
                                        <Border BackgroundColor="Black"
                                                StrokeThickness="0"
                                                Margin="6,6,0,0">
                                                <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="0"/>
                                                </Border.StrokeShape>
                                        </Border>
                                        <Border BackgroundColor="#E31D26"
                                                Stroke="White"
                                                StrokeThickness="1.5"
                                                Margin="0,0,6,6"
                                                Padding="26,10">
                                                <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="0"/>
                                                </Border.StrokeShape>
                                                <Label x:Name="LabelFecha"
                                                       TextColor="White"
                                                       FontSize="19"
                                                       FontAttributes="Bold, Italic"
                                                       FontFamily="Impact"
                                                       CharacterSpacing="0.5"/>
                                        </Border>
                                </Grid>

                                <!-- ======================================================================= -->
                                <!-- 📝 CUERPO CENTRAL: HOJA DE LIBRETA ENVEJECIDA CON DECORACIÓN INTERNA   -->
                                <!-- ======================================================================= -->
                                <Border Grid.Row="1"
                                        BackgroundColor="#EADFC9"
                                        Stroke="Black"
                                        StrokeThickness="3"
                                        Padding="40,35"
                                        Rotation="0">
                                        <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="20,0,35,5"/>
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                                <Shadow Brush="Black"
                                                        Offset="12,12"
                                                        Radius="0"
                                                        Opacity="0.85"/>
                                        </Border.Shadow>

                                        <!-- CONTENEDOR DE ENTRADAS Y GRAFITIS DE LA HOJA -->
                                        <Grid>
                                                <Path Data="M 450,10 L 470,25 L 490,10 L 480,35 L 500,50 L 470,45 L 450,60 L 460,35 Z"
                                                      Fill="Black"
                                                      Opacity="0.08"
                                                      Aspect="Fill"
                                                      HorizontalOptions="End"
                                                      VerticalOptions="Start"
                                                      Margin="0,5,10,0"/>
                                                <Path Data="M 10,10 L 30,10 L 30,80 L 45,70 L 20,100 L -5,70 L 10,80 Z"
                                                      Fill="#E31D26"
                                                      Opacity="0.05"
                                                      Aspect="Fill"
                                                      HorizontalOptions="End"
                                                      VerticalOptions="Center"
                                                      Margin="0,0,40,0"
                                                      Rotation="15"/>

                                                <VerticalStackLayout Spacing="24">

                                                        <!-- DETALLE DE LIBRETA: Agujeros vectoriales de las anillas -->
                                                        <AbsoluteLayout HeightRequest="0"
                                                                        WidthRequest="0"
                                                                        InputTransparent="True">
                                                                <Ellipse Fill="#0D0D0D"
                                                                         WidthRequest="12"
                                                                         HeightRequest="12"
                                                                         AbsoluteLayout.LayoutBounds="4, 15, 12, 12"/>
                                                                <Ellipse Fill="#0D0D0D"
                                                                         WidthRequest="12"
                                                                         HeightRequest="12"
                                                                         AbsoluteLayout.LayoutBounds="4, 110, 12, 12"/>
                                                                <Ellipse Fill="#0D0D0D"
                                                                         WidthRequest="12"
                                                                         HeightRequest="12"
                                                                         AbsoluteLayout.LayoutBounds="4, 205, 12, 12"/>
                                                                <Ellipse Fill="#0D0D0D"
                                                                         WidthRequest="12"
                                                                         HeightRequest="12"
                                                                         AbsoluteLayout.LayoutBounds="4, 300, 12, 12"/>
                                                        </AbsoluteLayout>

                                                        <!-- CAMPO 1: SELECCIONAR EL DÍA -->
                                                        <VerticalStackLayout Spacing="4">
                                                                <Border BackgroundColor="Black"
                                                                        StrokeThickness="0"
                                                                        HorizontalOptions="Start"
                                                                        Padding="15,5">
                                                                        <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="0"/>
                                                                        </Border.StrokeShape>
                                                                        <Label Text="FECHA DE LA MISIÓN"
                                                                               TextColor="White"
                                                                               FontSize="12"
                                                                               FontFamily="HelveticaNowDisplay-ExtraBold"
                                                                               FontAttributes="Bold"
                                                                               CharacterSpacing="0.5"/>
                                                                </Border>
                                                                <Border BackgroundColor="#DFD3BA"
                                                                        Stroke="Black"
                                                                        StrokeThickness="2.5"
                                                                        Padding="12,6">
                                                                        <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="0"/>
                                                                        </Border.StrokeShape>
                                                                        <DatePicker x:Name="PickerFecha"
                                                                                    MinimumDate="01/01/2020"
                                                                                    MaximumDate="12/31/2030"
                                                                                    TextColor="Black"
                                                                                    FontFamily="HelveticaNowDisplay-ExtraBold"
                                                                                    FontSize="16"/>
                                                                </Border>
                                                        </VerticalStackLayout>

                                                        <!-- CAMPO 2: TÍTULO DEL EVENTO -->
                                                        <VerticalStackLayout Spacing="4">
                                                                <Border BackgroundColor="#E31D26"
                                                                        StrokeThickness="0"
                                                                        HorizontalOptions="Start"
                                                                        Padding="15,5">
                                                                        <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="0"/>
                                                                        </Border.StrokeShape>
                                                                        <Label Text="NOMBRE DEL EVENTO"
                                                                               TextColor="White"
                                                                               FontSize="12"
                                                                               FontFamily="HelveticaNowDisplay-ExtraBold"
                                                                               FontAttributes="Bold"
                                                                               CharacterSpacing="0.5"/>
                                                                </Border>
                                                                <Entry x:Name="EntryTitulo"
                                                                       Placeholder="Escribe el objetivo aquí..."
                                                                       TextColor="Black"
                                                                       PlaceholderColor="#766C56"
                                                                       FontSize="16"
                                                                       FontAttributes="Bold"
                                                                       FontFamily="HelveticaNowDisplay-ExtraBold"
                                                                       BackgroundColor="Transparent"
                                                                       HeightRequest="42"
                                                                       VerticalTextAlignment="Center"
                                                                       Margin="5,2,0,0"/>
                                                                <BoxView HeightRequest="2.5"
                                                                         BackgroundColor="Black"/>
                                                        </VerticalStackLayout>
                                                        <!-- CAMPO 3: DESCRIPCIÓN -->
                                                        <VerticalStackLayout Spacing="4">
                                                                <Border BackgroundColor="Black"
                                                                        StrokeThickness="0"
                                                                        HorizontalOptions="Start"
                                                                        Padding="15,5">
                                                                        <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="0"/>
                                                                        </Border.StrokeShape>
                                                                        <Label Text="DETALLES DE LA INFILTRACIÓN"
                                                                               TextColor="White"
                                                                               FontSize="12"
                                                                               FontFamily="HelveticaNowDisplay-ExtraBold"
                                                                               FontAttributes="Bold"
                                                                               CharacterSpacing="0.5"/>
                                                                </Border>
                                                                <Editor x:Name="EditorDescripcion"
                                                                        Placeholder="Escribe las notas de campo..."
                                                                        HeightRequest="90"
                                                                        TextColor="Black"
                                                                        PlaceholderColor="#766C56"
                                                                        FontSize="15"
                                                                        FontAttributes="Bold"
                                                                        FontFamily="HelveticaNowDisplay-ExtraBold"
                                                                        BackgroundColor="Transparent"
                                                                        Margin="5,2,0,2"/>
                                                                <BoxView HeightRequest="2.5"
                                                                         BackgroundColor="Black"
                                                                         Opacity="0.8"/>
                                                        </VerticalStackLayout>

                                                        <!-- CAMPO 4: FRECUENCIA DEL EVENTO -->
                                                        <VerticalStackLayout Spacing="4">
                                                                <Border BackgroundColor="#222222"
                                                                        StrokeThickness="0"
                                                                        HorizontalOptions="Start"
                                                                        Padding="15,5">
                                                                        <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="0"/>
                                                                        </Border.StrokeShape>
                                                                        <Label Text="FRECUENCIA DEL EVENTO"
                                                                               TextColor="White"
                                                                               FontSize="11.5"
                                                                               FontFamily="HelveticaNowDisplay-ExtraBold"
                                                                               FontAttributes="Bold"/>
                                                                </Border>
                                                                <Picker x:Name="PickerFrecuencia"
                                                                        Title="Toca para seleccionar..."
                                                                        TitleColor="#766C56"
                                                                        TextColor="Black"
                                                                        FontFamily="HelveticaNowDisplay-ExtraBold"
                                                                        FontAttributes="Bold"
                                                                        FontSize="15"
                                                                        BackgroundColor="Transparent"
                                                                        Margin="5,2,0,0">
                                                                        <Picker.ItemsSource>
                                                                                <x:Array Type="{x:Type x:String}">
                                                                                        <x:String>Ninguna</x:String>
                                                                                        <x:String>Diario</x:String>
                                                                                        <x:String>Semanal</x:String>
                                                                                        <x:String>Mensual</x:String>
                                                                                        <x:String>Anual</x:String>
                                                                                </x:Array>
                                                                        </Picker.ItemsSource>
                                                                </Picker>
                                                                <BoxView HeightRequest="2"
                                                                         BackgroundColor="Black"
                                                                         Opacity="0.8"/>
                                                        </VerticalStackLayout>

                                                        <!-- CAMPO 5: HORA DEL EVENTO -->
                                                        <VerticalStackLayout Spacing="4">
                                                                <Border BackgroundColor="#222222"
                                                                        StrokeThickness="0"
                                                                        HorizontalOptions="Start"
                                                                        Padding="15,5">
                                                                        <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="0"/>
                                                                        </Border.StrokeShape>
                                                                        <Label Text="HORA DEL EVENTO (24H)"
                                                                               TextColor="White"
                                                                               FontSize="11.5"
                                                                               FontFamily="HelveticaNowDisplay-ExtraBold"
                                                                               FontAttributes="Bold"/>
                                                                </Border>
                                                                <TimePicker x:Name="PickerHora"
                                                                            Format="HH:mm"
                                                                            TextColor="Black"
                                                                            FontFamily="HelveticaNowDisplay-ExtraBold"
                                                                            FontAttributes="Bold"
                                                                            FontSize="16"
                                                                            BackgroundColor="Transparent"
                                                                            HorizontalOptions="Start"
                                                                            Margin="5,2,0,0"/>
                                                                <BoxView HeightRequest="2"
                                                                         BackgroundColor="Black"
                                                                         Opacity="0.8"/>
                                                        </VerticalStackLayout>
                                                        <!-- 🚨 CAMPO 6: SWITCH MODO EMBOSCADA ENMARCADO -->
                                                        <Border BackgroundColor="#0D0D0D"
                                                                Stroke="#E31D26"
                                                                StrokeThickness="2"
                                                                Padding="14,10"
                                                                Margin="0,8,0,0">
                                                                <Border.StrokeShape>
                                                                        <RoundRectangle CornerRadius="0"/>
                                                                </Border.StrokeShape>
                                                                <Grid ColumnDefinitions="*, Auto"
                                                                      VerticalOptions="Center">
                                                                        <VerticalStackLayout Grid.Column="0"
                                                                                             Spacing="2"
                                                                                             VerticalOptions="Center">
                                                                                <Label Text="🚨 MODO EMBOSCADA"
                                                                                       FontAttributes="Bold, Italic"
                                                                                       TextColor="White"
                                                                                       FontSize="15"
                                                                                       FontFamily="HelveticaNowDisplay-ExtraBold"
                                                                                       CharacterSpacing="0.3"/>
                                                                                <Label Text="Despierta el móvil con alarma de pantalla completa"
                                                                                       TextColor="#AAAAAA"
                                                                                       FontSize="11.5"
                                                                                       FontFamily="Arial"/>
                                                                        </VerticalStackLayout>
                                                                        <Switch Grid.Column="1"
                                                                                x:Name="SwitchAlarmaAgresiva"
                                                                                ThumbColor="#E31D26"
                                                                                OnColor="#333333"
                                                                                BackgroundColor="Transparent"
                                                                                HorizontalOptions="End"
                                                                                VerticalOptions="Center"
                                                                                Scale="0.95"/>
                                                                </Grid>
                                                        </Border>

                                                </VerticalStackLayout>
                                                <!-- Cierra el VerticalStackLayout de los campos internos -->

                                                <!-- Parches de cinta aislante negra pegados en las esquinas de la hoja -->
                                                <Polygon Points="0,0 60,0 0,35"
                                                         Fill="Black"
                                                         Rotation="-5"
                                                         HorizontalOptions="Start"
                                                         VerticalOptions="Start"
                                                         Margin="-42,-37,0,0"
                                                         InputTransparent="True"/>
                                                <Polygon Points="50,0 50,40 0,40"
                                                         Fill="Black"
                                                         Rotation="12"
                                                         HorizontalOptions="End"
                                                         VerticalOptions="End"
                                                         Margin="0,0,-42,-37"
                                                         InputTransparent="True"/>

                                        </Grid>
                                        <!-- Cierra el Grid contenedor de grafitis/anillas de la hoja -->
                                </Border>
                                <!-- Cierra el Border de la libreta claro -->

                                <!-- ======================================================================= -->
                                <!-- 🎛️ BOTONES DE CONTROL DE BAJO ACCIÓN: DECISIÓN COMPACTA DUOTONO        -->
                                <!-- ======================================================================= -->
                                <Grid Grid.Row="2"
                                      ColumnDefinitions="*, *"
                                      ColumnSpacing="25"
                                      Margin="0,25,0,0">

                                        <!-- BOTÓN: CREAR EVENTO -->
                                        <Grid Grid.Column="0"
                                              HeightRequest="50"
                                              Rotation="-3.5">
                                                <Border BackgroundColor="Black"
                                                        Stroke="White"
                                                        StrokeThickness="2"
                                                        InputTransparent="True">
                                                        <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="0"/>
                                                        </Border.StrokeShape>
                                                </Border>
                                                <Grid HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                                      InputTransparent="True">
                                                        <Label Text="DESATAR MISIÓN"
                                                               TextColor="#E31D26"
                                                               FontSize="15"
                                                               FontFamily="HelveticaNowDisplay-ExtraBold"
                                                               FontAttributes="Bold, Italic"
                                                               Margin="2,1,0,0"/>
                                                        <Label Text="DESATAR MISIÓN"
                                                               TextColor="White"
                                                               FontSize="15"
                                                               FontFamily="HelveticaNowDisplay-ExtraBold"
                                                               FontAttributes="Bold, Italic"/>
                                                </Grid>
                                                <Button BackgroundColor="Transparent"
                                                        Clicked="OnGuardarClicked"
                                                        HorizontalOptions="Fill"
                                                        VerticalOptions="Fill"/>
                                        </Grid>

                                        <!-- BOTÓN: ABORTAR -->
                                        <Grid Grid.Column="1"
                                              HeightRequest="50"
                                              Rotation="3">
                                                <Border BackgroundColor="White"
                                                        Stroke="Black"
                                                        StrokeThickness="2"
                                                        InputTransparent="True">
                                                        <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="0"/>
                                                        </Border.StrokeShape>
                                                </Border>
                                                <Grid HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                                      InputTransparent="True">
                                                        <Label Text="ABORTAR"
                                                               TextColor="#111111"
                                                               FontSize="15"
                                                               FontFamily="HelveticaNowDisplay-ExtraBold"
                                                               FontAttributes="Bold, Italic"
                                                               Margin="2,1,0,0"
                                                               Opacity="0.4"/>
                                                        <Label Text="ABORTAR"
                                                               TextColor="Black"
                                                               FontSize="15"
                                                               FontFamily="HelveticaNowDisplay-ExtraBold"
                                                               FontAttributes="Bold, Italic"/>
                                                </Grid>
                                                <Button BackgroundColor="Transparent"
                                                        Clicked="OnCancelarClicked"
                                                        HorizontalOptions="Fill"
                                                        VerticalOptions="Fill"/>
                                        </Grid>

                                </Grid>
                                <!-- Cierra el Grid de botones inferiores -->

                        </Grid>
                        <!-- Cierra el Grid maestro del formulario (Ancho 620) -->
                </ScrollView>
        </Grid>
        <!-- Cierra el Grid estructural base de la ContentPage -->
</ContentPage>
