<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiTime.Models"
             xmlns:converters="clr-namespace:MauiTime.Converters"
             x:Class="MauiTime.Views.AgendaPage"
             BackgroundColor="#1A1A1A"
             Title="P5_AGENDA"
             Shell.TabBarIsVisible="False">
    <!-- TODO:Eliminar NavigationBar para que no se vea el título de la página -->

    <Grid>
        <!-- ==================== CAPA DE FONDO ALTO CONTRASTE (P5 STYLE) ==================== -->
        <Grid HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <!-- Polígono Rojo Superior Izquierdo Agresivo -->
            <Polygon Points="0,0 900,0 400,700 0,500"
                     Fill="#E31D26"
                     Opacity="0.85"
                     Aspect="Fill"/>

            <!-- Gran Cuchillada Roja Inferior Derecha (Cruza hacia arriba) -->
            <Polygon Points="1200,2000 2000,1100 2000,2000"
                     Fill="#E31D26"
                     Opacity="0.9"
                     Aspect="Fill"/>

            <!-- Línea de rasgadura negra pura que rompe la forma superior -->
            <Line X1="0"
                  Y1="450"
                  X2="1300"
                  Y2="0"
                  Stroke="#0A0A0A"
                  StrokeThickness="40"
                  Aspect="Fill"/>

            <!-- Franja blanca tipo destello de cómic en el fondo -->
            <Line X1="300"
                  Y1="2000"
                  X2="2000"
                  Y2="900"
                  Stroke="White"
                  StrokeThickness="10"
                  Opacity="0.15"
                  Aspect="Fill"/>

        </Grid>  

        <!-- ==================== CAPA DEL CONTENIDO (VERTICAL ANDROID / COLLAGE WINUI) ==================== -->
        <Grid RowDefinitions="{OnPlatform Android='Auto, Auto, Auto, *, Auto', WinUI='Auto, *, Auto'}"
              Padding="{OnPlatform Android='8,10,8,8', WinUI='20'}">

            <!-- FILA 0: TÍTULO PRINCIPAL (AGENDA DE EVENTOS) -->
            <Border Grid.Row="{OnPlatform Android=0, WinUI=0}"
                    BackgroundColor="#E31D26"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    StrokeThickness="0"
                    Rotation="{OnPlatform Android=-2, WinUI=-5}"
                    Margin="{OnPlatform Android='0,10,0,12', WinUI='10,20,0,0'}"
                    Padding="{OnPlatform Android='12,6', WinUI='20,10'}"
                    ZIndex="{OnPlatform Android=0, WinUI=2}">
                <Border.Shadow>
                    <Shadow Brush="Black"
                            Offset="{OnPlatform Android='3,3', WinUI='6,6'}"
                            Radius="0"
                            Opacity="0.8"/>
                </Border.Shadow>
                <FlexLayout x:Name="ContenedorTitulo"
                            Wrap="Wrap"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
            </Border>

            <!-- FILA 1 (Android) / capa collage (WinUI): PESTAÑAS AGENDA / CALENDARIO -->
            <Grid Grid.Row="{OnPlatform Android=1, WinUI=0}"
                  ColumnDefinitions="{OnPlatform Android='*, *', WinUI='Auto, Auto'}"
                  ColumnSpacing="{OnPlatform Android=8, WinUI=0}"
                  HorizontalOptions="{OnPlatform Android=Fill, WinUI=Start}"
                  VerticalOptions="{OnPlatform Android=Center, WinUI=Start}"
                  Rotation="{OnPlatform Android=0, WinUI=0}"
                  Margin="{OnPlatform Android='0,0,0,8', WinUI='15,95,0,20'}"
                  ZIndex="{OnPlatform Android=0, WinUI=2}">

                <Border x:Name="TabAgenda"
                        Grid.Column="0"
                        BackgroundColor="Black"
                        Stroke="White"
                        StrokeThickness="2"
                        Rotation="{OnPlatform Android=-2, WinUI=-4}"
                        HorizontalOptions="{OnPlatform Android=Fill, WinUI=Start}"
                        ZIndex="{OnPlatform Android=0, WinUI=2}"
                        Padding="{OnPlatform Android='22,8', WinUI='30,12'}"
                        MinimumHeightRequest="{OnPlatform Android=48, WinUI=48}">
                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Offset="{OnPlatform Android='3,3', WinUI='5,5'}"
                                Radius="0"
                                Opacity="0.8"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAgendaTabTapped"/>
                        <PointerGestureRecognizer PointerEntered="OnTabAgendaMouseIn"
                                                  PointerExited="OnTabAgendaMouseOut"/>
                    </Border.GestureRecognizers>

                    <Label Text="AGENDA"
                           TextColor="#E31D26"
                           FontSize="{OnPlatform Android=16, WinUI=21}"
                           FontAttributes="Bold, Italic"
                           FontFamily="Impact"
                           HorizontalOptions="Center"
                           CharacterSpacing="0"/>
                </Border>

                <Border x:Name="TabCalendario"
                        Grid.Column="1"
                        BackgroundColor="#E5E5E5"
                        Stroke="Black"
                        StrokeThickness="1.5"
                        Rotation="{OnPlatform Android=2, WinUI=3}"
                        HorizontalOptions="{OnPlatform Android=Fill, WinUI=Start}"
                        ZIndex="{OnPlatform Android=0, WinUI=1}"
                        Margin="{OnPlatform Android='0,0,0,0', WinUI='-25,2,0,0'}"
                        Padding="{OnPlatform Android='22,8', WinUI='35,12'}"
                        MinimumHeightRequest="{OnPlatform Android=48, WinUI=48}">
                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Offset="{OnPlatform Android='2,2', WinUI='4,4'}"
                                Radius="0"
                                Opacity="0.5"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCalendarioTabTapped"/>
                        <PointerGestureRecognizer PointerEntered="OnTabCalendarioMouseIn"
                                                  PointerExited="OnTabCalendarioMouseOut"/>
                    </Border.GestureRecognizers>

                    <Label Text="CALENDARIO"
                           TextColor="#222222"
                           FontSize="{OnPlatform Android=15, WinUI=21}"
                           FontAttributes="Bold, Italic"
                           FontFamily="Impact"
                           HorizontalOptions="Center"
                           CharacterSpacing="0"
                           LineBreakMode="NoWrap"/>
                </Border>
            </Grid>

            <!-- FILA 2 (Android) / capa collage (WinUI): INICIAR INFILTRACIÓN -->
            <Grid x:Name="BtnInfiltracion"
                  Grid.Row="{OnPlatform Android=2, WinUI=0}"
                  HorizontalOptions="{OnPlatform Android=Fill, WinUI=End}"
                  VerticalOptions="{OnPlatform Android=Center, WinUI=Start}"
                  Margin="{OnPlatform Android='0,0,0,10', WinUI='0,88,0,0'}"
                  Rotation="{OnPlatform Android=0, WinUI=4}"
                  HeightRequest="{OnPlatform Android=50, WinUI=48}"
                  ZIndex="{OnPlatform Android=0, WinUI=999}">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCrearProyectoClicked"/>
                    <PointerGestureRecognizer PointerEntered="OnBtnInfiltracionMouseIn"
                                              PointerExited="OnBtnInfiltracionMouseOut"/>
                </Grid.GestureRecognizers>

                <Border BackgroundColor="Black"
                        Stroke="White"
                        StrokeThickness="1.5"
                        InputTransparent="True">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0"/>
                    </Border.StrokeShape>
                </Border>

                <Grid ColumnDefinitions="Auto, *"
                      Padding="{OnPlatform Android='14,0', WinUI='32,0'}"
                      InputTransparent="True"
                      VerticalOptions="Center">

                    <Grid Grid.Column="0"
                          WidthRequest="14"
                          HeightRequest="14"
                          VerticalOptions="Center"
                          Rotation="15"
                          Margin="0,0,10,0">
                        <Path Data="M 7,0 L 14,7 L 7,14 L 0,7 Z"
                              Fill="#E31D26"/>
                        <Path Data="M 7,0 L 14,7 L 7,14 L 0,7 Z"
                              Stroke="White"
                              StrokeThickness="1"/>
                        <Path Data="M 7,3 L 7,11 M 3,7 L 11,7"
                              Stroke="White"
                              StrokeThickness="1.5"/>
                    </Grid>

                    <Label Grid.Column="1"
                           Text="INICIAR INFILTRACIÓN"
                           TextColor="#F0F0F0"
                           FontSize="{OnPlatform Android=14, WinUI=20}"
                           FontFamily="Impact"
                           CharacterSpacing="0"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Grid>
            </Grid>

            <!-- FILA 3 (Android) / FILA 1 (WinUI): LISTA DE EVENTOS + SCROLLBAR -->
            <Grid Grid.Row="{OnPlatform Android=3, WinUI=1}"
                  ColumnDefinitions="*, 20">

                    <!-- Ocultamos la barra nativa con VerticalScrollBarVisibility="Never" -->
                    <!-- Conectamos con el evento Scrolled del archivo C# -->
                    <CollectionView x:Name="ListaEventos"
                                    Grid.Column="0"
                                    ItemsSource="{Binding Eventos}"
                                    VerticalScrollBarVisibility="Never"
                                    Scrolled="OnListaEventosScrolled">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Evento">
                                <!-- Piezas de puzle roto: HUD de fecha + tarjeta negra ensanchada en Android -->
                                <Grid ColumnDefinitions="{OnPlatform Android='100, *', WinUI='125, *'}"
                                      Margin="{OnPlatform Android='0,5', WinUI='0,5'}"
                                      Padding="{OnPlatform Android='2,10', WinUI='8,10'}"
                                      HorizontalOptions="Fill">


                                    <!-- ==================== NUEVO HUD DE FECHA ESTILO P5 ==================== -->
                                    <Grid Grid.Column="0"
                                          HeightRequest="85"
                                          WidthRequest="100"
                                          VerticalOptions="Center"
                                          HorizontalOptions="Center"
                                          ZIndex="2">

                                        <!-- Contenedor absoluto para poder encimar las figuras geométricas estilo collage -->
                                        <AbsoluteLayout x:Name="HudFechaP5"
                                                        HorizontalOptions="Fill"
                                                        VerticalOptions="Fill"
                                                        BindingContextChanged="OnFechaHudBindingContextChanged"/>
                                    </Grid>

                                    <!-- TARJETA DEL EVENTO (RESTANTE NEGRO LIMPIO + TÍTULO DUOTONO P5) -->
                                    <Border
                                        x:Name="TarjetaBase"
                                        Grid.Column="1"
                                        BackgroundColor="Black"
                                        Stroke="White"
                                        StrokeThickness="2"
                                        HorizontalOptions="Fill"
                                        Margin="{OnPlatform Android='-24,0,0,0', WinUI='-15,0,0,0'}"
                                        Padding="{OnPlatform Android='28,16,10,16', WinUI='35,16,15,16'}"
                                        VerticalOptions="Center"
                                        ZIndex="1">
                                        <Border.Shadow>
                                            <Shadow Brush="Black"
                                                    Offset="4,4"
                                                    Radius="0"
                                                    Opacity="0.5"/>
                                        </Border.Shadow>

                                        <!-- Distribución horizontal interna para las descripciones -->
                                        <Grid ColumnDefinitions="*, Auto"
                                              VerticalOptions="Center">

                                            <!-- Bloque Izquierdo Opciones de Texto: Título Duotono y Descripción -->
                                            <VerticalStackLayout Grid.Column="0"
                                                                 VerticalOptions="Center"
                                                                 Spacing="2">

                                                <!-- EFECTO DUOTONO: Dos Labels solapados para crear la sombra sólida e imperfecta -->
                                                <Grid HorizontalOptions="Start"
                                                      VerticalOptions="Center">

                                                    <!-- 1. Sombra Roja Sólida (Desplazada abajo a la derecha) -->
                                                    <Label Text="{Binding Titulo}"
                                                           TextColor="#E31D26"
                                                           FontSize="20"
                                                           FontFamily="HelveticaNowDisplay-ExtraBold"
                                                           TextTransform="Uppercase"
                                                           CharacterSpacing="-0.5"
                                                           Margin="2,2,0,0"
                                                           VerticalOptions="Center"/>

                                                    <!-- 2. Texto Principal Blanco (Encima de la sombra) -->
                                                    <Label Text="{Binding Titulo}"
                                                           TextColor="White"
                                                           FontSize="20"
                                                           FontFamily="HelveticaNowDisplay-ExtraBold"
                                                           TextTransform="Uppercase"
                                                           CharacterSpacing="-0.5"
                                                           VerticalOptions="Center"/>
                                                </Grid>

                                                <!-- DESCRIPCIÓN DEL EVENTO -->
                                                <Label Text="{Binding Descripcion}"
                                                       TextColor="#B5B5B5"
                                                       FontSize="13"
                                                       FontFamily="OpenSansRegular"
                                                       Margin="2,2,0,0"/>
                                            </VerticalStackLayout>

                                            <!-- Bloque Derecho Estilo HUD: Hora apilada verticalmente sobre el Sticker -->
                                            <VerticalStackLayout Grid.Column="1"
                                                                 HorizontalOptions="End"
                                                                 VerticalOptions="Center"
                                                                 Spacing="4"
                                                                 Margin="0,5,15,0"
                                                                 ZIndex="4">

                                                <!-- CONTENEDOR DE LA HORA + EL OJO DEL TARGET INTERACTIVO -->
                                                <HorizontalStackLayout HorizontalOptions="End"
                                                                       Spacing="6"
                                                                       Rotation="4"
                                                                       Margin="0,0,4,0">

                                                    <!-- ============================================================ -->
                                                    <!-- 💡 BOTÓN INTERACTIVO: EL OJO DEL TARGET CONMUTABLE POR GPU -->
                                                    <!-- ============================================================ -->
                                                    <Grid WidthRequest="18"
                                                          HeightRequest="18"
                                                          VerticalOptions="Center"
                                                          BackgroundColor="Transparent"
                                                          InputTransparent="False"
                                                          CascadeInputTransparent="False">

                                                        <!-- CAPA 1: El Rombo Apagado (Siempre de color Gris Oscuro de fondo) -->
                                                        <Path Data="M 9,0 L 18,9 L 9,18 L 0,9 Z"
                                                              Stroke="#333333"
                                                              StrokeThickness="1.5"
                                                              Fill="#01000000"/>
                                                        <Path Data="M 9,5 L 9,11 M 9,13 L 9,14"
                                                              Stroke="#333333"
                                                              StrokeThickness="2.5"
                                                              Fill="#01000000"/>

                                                        <!-- CAPA 2: El Rombo Encendido (Rojo Fuego) se superpone encima de la Capa 1 
                 Su visibilidad reacciona directamente al booleano gracias a INotifyPropertyChanged -->
                                                        <!-- CAPA 2: El Rombo Encendido (Rojo Fuego) se superpone encima de la Capa 1 -->
                                                        <Grid x:Name="CapaRojoFuego"
                                                              IsVisible="{Binding EsAlarmaAgresiva}">
                                                            <Path Data="M 9,0 L 18,9 L 9,18 L 0,9 Z"
                                                                  Stroke="#E31D26"
                                                                  StrokeThickness="1.5"/>
                                                            <Path Data="M 9,5 L 9,11 M 9,13 L 9,14"
                                                                  Stroke="#E31D26"
                                                                  StrokeThickness="2.5"/>
                                                        </Grid>


                                                        <!-- Capturador de Clic para Escritorio y Toque para Android -->
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnMitigarAlarmaTargetClicked"/>
                                                        </Grid.GestureRecognizers>
                                                    </Grid>

                                                    <!-- Texto de la Hora -->
                                                    <Label Text="{Binding Hora}"
                                                           TextColor="#E31D26"
                                                           FontSize="17"
                                                           FontFamily="HelveticaNowDisplay-ExtraBold"
                                                           VerticalOptions="Center"
                                                           CharacterSpacing="-0.5"/>
                                                </HorizontalStackLayout>

                                                <!-- ============================================================ -->
                                                <!-- Contenedor Unificado de Stickers -->
                                                <Grid>
                                                    <!-- Sticker Anual -->
                                                    <Grid IsVisible="{Binding EsAnual}"
                                                          WidthRequest="78"
                                                          HeightRequest="32"
                                                          Rotation="-7">
                                                        <Polygon Points="3,5 78,3 73,35 8,31"
                                                                 Fill="Black"
                                                                 Aspect="Fill"/>
                                                        <Polygon Points="0,2 75,0 70,32 5,28"
                                                                 Fill="#E31D26"
                                                                 Stroke="White"
                                                                 StrokeThickness="1.5"
                                                                 Aspect="Fill"/>
                                                        <Label Text="ANUAL"
                                                               TextColor="White"
                                                               FontSize="12.5"
                                                               FontAttributes="Bold"
                                                               FontFamily="HelveticaNowDisplay-ExtraBold"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"
                                                               CharacterSpacing="-0.5"/>
                                                    </Grid>

                                                    <!-- Sticker Mensual -->
                                                    <Grid IsVisible="{Binding EsMensual}"
                                                          WidthRequest="92"
                                                          HeightRequest="32"
                                                          Rotation="6">
                                                        <Polygon Points="11,3 93,7 83,35 3,29"
                                                                 Fill="Black"
                                                                 Aspect="Fill"/>
                                                        <Polygon Points="8,0 90,4 80,32 0,26"
                                                                 Fill="#E31D26"
                                                                 Stroke="White"
                                                                 StrokeThickness="1.5"
                                                                 Aspect="Fill"/>
                                                        <Label Text="MENSUAL"
                                                               TextColor="White"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               FontFamily="HelveticaNowDisplay-ExtraBold"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"
                                                               CharacterSpacing="-0.5"/>
                                                    </Grid>

                                                    <!-- Sticker Semanal -->
                                                    <Grid IsVisible="{Binding EsSemanal}"
                                                          WidthRequest="92"
                                                          HeightRequest="32"
                                                          Rotation="-5">
                                                        <Polygon Points="3,8 88,3 93,29 8,35"
                                                                 Fill="Black"
                                                                 Aspect="Fill"/>
                                                        <Polygon Points="0,5 85,0 90,26 5,32"
                                                                 Fill="#E31D26"
                                                                 Stroke="White"
                                                                 StrokeThickness="1.5"
                                                                 Aspect="Fill"/>
                                                        <Label Text="SEMANAL"
                                                               TextColor="White"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               FontFamily="HelveticaNowDisplay-ExtraBold"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"
                                                               CharacterSpacing="-0.5"/>
                                                    </Grid>

                                                    <!-- Sticker Diario -->
                                                    <Grid IsVisible="{Binding EsDiario}"
                                                          WidthRequest="78"
                                                          HeightRequest="32"
                                                          Rotation="8">
                                                        <Polygon Points="7,3 78,8 69,35 3,27"
                                                                 Fill="Black"
                                                                 Aspect="Fill"/>
                                                        <Polygon Points="4,0 75,5 66,32 0,24"
                                                                 Fill="#E31D26"
                                                                 Stroke="White"
                                                                 StrokeThickness="1.5"
                                                                 Aspect="Fill"/>
                                                        <Label Text="DIARIO"
                                                               TextColor="White"
                                                               FontSize="12.5"
                                                               FontAttributes="Bold"
                                                               FontFamily="HelveticaNowDisplay-ExtraBold"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"
                                                               CharacterSpacing="-0.5"/>
                                                    </Grid>
                                                </Grid>

                                            </VerticalStackLayout>
                                        </Grid>
                                        <!-- 💣 SENSOR DE BORRADO DE LA AGENDA CONECTADO A TU SQLITE -->
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnEliminarProyectoClicked"/>
                                        </Border.GestureRecognizers>
                                    </Border>

                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>
                


                <!-- ==================== SCROLLBAR ESTILO PERSONA 5 (CALIBRACIÓN MILIMÉTRICA) ==================== -->
                <!-- Cambiado el margen inferior a 52 para acortar el carril y alinearlo al final real del scroll -->
                <Grid Grid.Column="1"
                      WidthRequest="20"
                      HorizontalOptions="End"
                      Margin="0,35,0,52">
                    <AbsoluteLayout HorizontalOptions="Fill"
                                    VerticalOptions="Fill">

                        <!-- Carril vertical blanco recto -->
                        <BoxView WidthRequest="2"
                                 BackgroundColor="White"
                                 Opacity="0.3"
                                 AbsoluteLayout.LayoutBounds="0.5, 0, 2, 1"
                                 AbsoluteLayout.LayoutFlags="XProportional, HeightProportional"/>

                        <!-- Puntero del Scroll: Rombo rojo con flags X e Y proporcionales activos -->
                        <Border x:Name="PunteroScrollP5"
                                BackgroundColor="#E31D26"
                                Stroke="White"
                                StrokeThickness="1.5"
                                HeightRequest="24"
                                WidthRequest="14"
                                Rotation="15"
                                AbsoluteLayout.LayoutBounds="0.5, 0, 14, 24"
                                AbsoluteLayout.LayoutFlags="XProportional, YProportional">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="0"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black"
                                        Offset="3,3"
                                        Radius="0"
                                        Opacity="0.6"/>
                            </Border.Shadow>
                        </Border>
                    </AbsoluteLayout>
                </Grid>

            </Grid>

            <!-- FILA 4 (Android) / FILA 2 (WinUI): ESTRELLA DECORATIVA INFERIOR -->
            <AbsoluteLayout Grid.Row="{OnPlatform Android=4, WinUI=2}"
                            HorizontalOptions="End"
                            VerticalOptions="End"
                            Margin="{OnPlatform Android='0,0,60,40', WinUI='0,0,60,40'}"
                            Opacity="0.4">
                <Polygon Points="25,0 32,15 49,18 37,30 40,47 25,39 9,47 13,30 1,18 17,15"
                         Fill="White"
                         Scale="3.0"
                         AbsoluteLayout.LayoutBounds="0,0,50,50"/>
                <Polygon Points="25,0 32,15 49,18 37,30 40,47 25,39 9,47 13,30 1,18 17,15"
                         Fill="#E31D26"
                         Scale="1.8"
                         Rotation="28"
                         AbsoluteLayout.LayoutBounds="45,20,50,50"/>
            </AbsoluteLayout>

            <!-- ======================================================================= -->
            <!-- 🎭 POPUP DE CONFIRMACIÓN: CUADRO SÓLIDO DE ÁNGULOS DUROS                -->
            <!-- ======================================================================= -->
            <Grid x:Name="ContenedorPopupBorrar"
                  Grid.RowSpan="{OnPlatform Android=5, WinUI=3}"
                  Grid.ColumnSpan="1"
                  BackgroundColor="#A5000000"
                  ZIndex="9999"
                  IsVisible="False"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill"
                  Margin="-50">

                <!-- Lienzo Maestro Compacto -->
                <Grid WidthRequest="540"
                      HeightRequest="230"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      Rotation="-2">
                    <!-- Una única rotación limpia para todo el conjunto -->

                    <!-- Sombra Sólida Dura Negra Desplazada -->
                    <Border BackgroundColor="Black"
                            StrokeThickness="0"
                            Margin="12,12,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0"/>
                        </Border.StrokeShape>
                    </Border>

                    <!-- Cuerpo Principal en Rojo Fuego Puro (Líneas limpias sin polígonos cruzados) -->
                    <Border BackgroundColor="#E31D26"
                            Stroke="White"
                            StrokeThickness="3"
                            Margin="0,0,12,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0"/>
                        </Border.StrokeShape>

                        <Grid RowDefinitions="*, Auto"
                              Padding="25,20">

                            <!-- BLOQUE CENTRAL: CAJA NEGRA RECTANGULAR SÓLIDA -->
                            <Border Grid.Row="0"
                                    BackgroundColor="Black"
                                    Stroke="White"
                                    StrokeThickness="1.5"
                                    VerticalOptions="Center"
                                    Padding="20,15">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="0"/>
                                </Border.StrokeShape>

                                <!-- Texto Duotono Limpio sobre Fondo Negro -->
                                <Grid>
                                    <Label x:Name="TxtPreguntaBorrarSombra"
                                           Text="¿ELIMINAR OBJETIVO?"
                                           TextColor="#E31D26"
                                           FontSize="15"
                                           FontFamily="HelveticaNowDisplay-ExtraBold"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           CharacterSpacing="-0.3"
                                           Margin="2,2,0,0"
                                           LineBreakMode="WordWrap"
                                           VerticalOptions="Center"/>
                                    <Label x:Name="TxtPreguntaBorrar"
                                           Text="¿ELIMINAR OBJETIVO?"
                                           TextColor="White"
                                           FontSize="15"
                                           FontFamily="HelveticaNowDisplay-ExtraBold"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           CharacterSpacing="-0.3"
                                           LineBreakMode="WordWrap"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                            <!-- BLOQUE DE BOTONES: BLINDAJE DE ENTRADA GRÁFICA -->
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*, *"
                                  ColumnSpacing="20"
                                  Margin="0,15,0,0">

                                <!-- ============================================================ -->
                                <!-- BOTÓN ACCIÓN: BORRAR (Tarjeta Negra con Sombra de Texto Roja) -->
                                <!-- ============================================================ -->
                                <!-- 🚀 ASIGNADO: x:Name="BtnBorrarGrid" para que se anime por C# -->
                                <Grid x:Name="BtnBorrarGrid"
                                      Grid.Column="0"
                                      HeightRequest="44">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnConfirmarBorradoPunkClicked"/>
                                        <!-- 💻 CAPTURA DEL PUNTERO DEL RATÓN -->
                                        <PointerGestureRecognizer PointerEntered="OnBtnBorrarMouseIn"
                                                                  PointerExited="OnBtnBorrarMouseOut"/>
                                    </Grid.GestureRecognizers>

                                    <!-- Fondo visual del botón -->
                                    <Border BackgroundColor="Black"
                                            Stroke="White"
                                            StrokeThickness="2"
                                            InputTransparent="True">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="0"/>
                                        </Border.StrokeShape>
                                    </Border>

                                    <!-- Capa de Textos Duotono -->
                                    <Grid HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          InputTransparent="True">
                                        <!-- 1. Sombra Roja Sólida (Desplazada abajo-derecha) -->
                                        <Label Text="BORRAR"
                                               TextColor="#E31D26"
                                               FontSize="14"
                                               FontFamily="HelveticaNowDisplay-ExtraBold"
                                               CharacterSpacing="-0.5"
                                               Margin="2,1,0,0"/>
                                        <!-- 2. Texto Principal Blanco -->
                                        <Label Text="BORRAR"
                                               TextColor="White"
                                               FontSize="14"
