<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTime.Views.TransicionCristalPage"
             BackgroundColor="Black"
             Title="P5_SHATTER_UNIFIED"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False">

    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
        <AbsoluteLayout x:Name="ContenedorCristales"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">

            <!-- F1 a F8: Las placas masivas de fondo -->
            <Path StyleId="F1" Data="M 0,0 L 400,0 L 630,350 L 0,200 Z" Fill="#E31D26" Stroke="Black" StrokeThickness="4" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" ZIndex="1"/>
            <Path StyleId="F2" Data="M 400,0 L 850,0 L 642,345 Z" Fill="#E31D26" Stroke="Black" StrokeThickness="4" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" ZIndex="2"/>
            <Path StyleId="F3" Data="M 850,0 L 1280,0 L 1280,250 L 650,352 Z" Fill="#E31D26" Stroke="Black" StrokeThickness="4" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" ZIndex="3"/>
            <Path StyleId="F4" Data="M 1280,250 L 1280,500 L 652,368 Z" Fill="#E31D26" Stroke="Black" StrokeThickness="4" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" ZIndex="4"/>
            <Path StyleId="F5" Data="M 1280,500 L 1280,720 L 900,720 L 645,372 Z" Fill="#E31D26" Stroke="Black" StrokeThickness="4" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" ZIndex="5"/>
            <Path StyleId="F6" Data="M 900,720 L 450,720 L 635,375 Z" Fill="#E31D26" Stroke="Black" StrokeThickness="4" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" ZIndex="6"/>
            <Path StyleId="F7" Data="M 450,720 L 0,720 L 0,450 L 628,365 Z" Fill="#E31D26" Stroke="Black" StrokeThickness="4" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" ZIndex="7"/>
            <Path StyleId="F8" Data="M 0,450 L 0,200 L 625,355 Z" Fill="#E31D26" Stroke="Black" StrokeThickness="4" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" ZIndex="8"/>

            <!-- Capa del Disparo Negro Central -->
            <Border x:Name="CentroImpacto"
                    StyleId="CentroImpacto"
                    BackgroundColor="Black"
                    WidthRequest="90"
                    HeightRequest="90"
                    Rotation="14"
                    Scale="0"
                    StrokeThickness="0"
                    StrokeShape="Polygon 5,12 35,0 90,22 75,72 25,85 0,55"
                    AbsoluteLayout.LayoutBounds="640,360,90,90"
                    AbsoluteLayout.LayoutFlags="None"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    ZIndex="90"/>

            <!-- 💥 METRALLA UNIFICADA: Ahora son del mismo material rojo con borde negro tosco -->
            <Path x:Name="MiniMetralla1" StyleId="M1" Data="M 610,320 L 638,310 L 622,335 Z" Fill="#E31D26" Stroke="Black" StrokeThickness="3" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" ZIndex="100"/>
            <Path x:Name="MiniMetralla2" StyleId="M2" Data="M 648,360 L 685,385 L 655,395 Z" Fill="#E31D26" Stroke="Black" StrokeThickness="3" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" ZIndex="101"/>

        </AbsoluteLayout>
    </Grid>
</ContentPage>