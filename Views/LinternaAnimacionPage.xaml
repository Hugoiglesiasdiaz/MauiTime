<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTime.Views.LinternaAnimacionPage"
             BackgroundColor="Black"
             Shell.PresentationMode="NotAnimated"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False">

    <!-- Cambiamos a Grid completo para que las líneas se calculen sobre el lienzo total -->
    <Grid>
        
        <!-- CONTENEDOR DE IMPACTO ANIME: Generado dinámicamente -->
        <AbsoluteLayout x:Name="ContenedorLineasAccion"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        Opacity="0"
                        InputTransparent="True"/>

        <!-- CONTENEDOR DE LA LINTERNA -->
        <Border x:Name="FocoLinterna"
                WidthRequest="260"
                HeightRequest="260"
                BackgroundColor="White"
                StrokeThickness="0"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="130"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,0" Radius="40" Opacity="0.95"/>
            </Border.Shadow>

            <Label x:Name="TextoLinterna"
                   Text="SEARCHING..."
                   FontFamily="Impact"
                   TextColor="Black"
                   FontSize="26"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Rotation="-15"/>
        </Border>
        
    </Grid>
</ContentPage>