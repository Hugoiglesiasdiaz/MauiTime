<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTime.Views.LinternaAnimacionPage"
             BackgroundColor="Black"
             Shell.PresentationMode="NotAnimated"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False">

    <!-- Grid completo para el cálculo del lienzo total de la GPU -->
    <Grid>

        <!-- CONTENEDOR DE IMPACTO ANIME: Generado dinámicamente -->
        <AbsoluteLayout x:Name="ContenedorLineasAccion"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        Opacity="0"
                        InputTransparent="True"/>

        <!-- CONTENEDOR DE LA LINTERNA (CON GRADIENTE RADIAL REALISTA) -->
        <Border x:Name="FocoLinterna"
                WidthRequest="260"
                HeightRequest="260"
                StrokeThickness="0"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="130"/>
            </Border.StrokeShape>

            <!-- 🎨 CORRECCIÓN SUPREMA: Pincel inyectado en la propiedad Background nativa -->
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5"
                        Radius="0.5">
                    <!-- Centro del círculo: Blanco puro hiper-brillante -->
                    <GradientStop Color="#FFFFFF"
                            Offset="0.0"/>

                    <!-- Haz de luz intermedio: Tono azulado frío/grisáceo de cómic nocturno -->
                    <GradientStop Color="#D1E4E8"
                            Offset="0.4"/>

                    <!-- Dispersión de penumbra: Azul acero oscuro traslúcido -->
                    <GradientStop Color="#405560"
                            Offset="0.75"/>

                    <!-- Borde exterior: Transparencia absoluta para fundirse con el fondo negro -->
                    <GradientStop Color="#00000000"
                            Offset="1.0"/>
                </RadialGradientBrush>
            </Border.Background>

            <!-- Sombra difuminada de soporte para WinUI3 -->
            <Border.Shadow>
                <Shadow Brush="Black"
                        Offset="0,0"
                        Radius="45"
                        Opacity="0.95"/>
            </Border.Shadow>

            <!-- TEXTO DE INFILTRACIÓN PHANTOM THIEVES -->
            <Label x:Name="TextoLinterna"
                   Text="SEARCHING..."
                   FontFamily="Impact"
                   TextColor="Black"
                   FontSize="26"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Rotation="-15"/>
        </Border>

    </Grid>
</ContentPage>
