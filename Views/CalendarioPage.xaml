<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiTime.Models"
             x:Class="MauiTime.Views.CalendarioPage"
             BackgroundColor="#1A1A1A"
             Title="P5_CALENDARIO"
             Shell.TabBarIsVisible="False">

    <Grid>
        <!-- ==================== CAPA DE FONDO ALTO CONTRASTE (P5 CALENDARIO - UNIFICACIÓN ESTILO CORREGIDO) ==================== -->
        <Grid HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <!-- BLOQUE ROJO DERECHO: Tu estructura original pero con un borde blanco que le da efecto recorte fanzine -->
            <Border BackgroundColor="#E31D26"
                    Stroke="White"
                    StrokeThickness="2"
                    HorizontalOptions="End"
                    VerticalOptions="Fill"
                    WidthRequest="250"
                    Rotation="3"
                    Margin="0,-50,-50,-50">
                <Border.Shadow>
                    <Shadow Brush="Black"
                            Offset="-5,0"
                            Radius="0"
                            Opacity="0.5"/>
                </Border.Shadow>
            </Border>

            <!-- POLÍGONO NEGRO SUPERIOR IZQUIERDO: Tu forma exacta que enmarca de forma brutal las pestañas -->
            <Polygon Points="0,0 600,0 450,400 0,350"
                     Fill="#0A0A0A"
                     Opacity="0.95"/>

            <!-- BARRA DIAGONAL CENTRAL CORREGIDA: Le bajamos la opacidad al 35% para proteger la lectura de tus números -->
            <BoxView Color="White"
                     HeightRequest="12"
                     Rotation="-15"
                     VerticalOptions="Center"
                     HorizontalOptions="Fill"
                     Margin="-50,0"
                     Opacity="0.35"/>

            <!-- LÍNEAS VERTICALES IZQUIERDAS MEJORADAS: Moverlas al centro-izquierdo para rellenar el vacío y dar equilibrio -->
            <StackLayout Orientation="Horizontal"
                         Spacing="15"
                         Opacity="0.15"
                         HorizontalOptions="Start"
                         VerticalOptions="Fill"
                         Margin="80,0,0,0">
                <BoxView Color="White"
                         WidthRequest="2"
                         VerticalOptions="Fill"/>
                <BoxView Color="White"
                         WidthRequest="4"
                         VerticalOptions="Fill"/>
                <BoxView Color="White"
                         WidthRequest="2"
                         VerticalOptions="Fill"/>
            </StackLayout>

            <!-- CÍRCULOS DE IMPACTO CONCÉNTRICOS: Tu estructura original intacta abajo a la izquierda -->
            <Ellipse Fill="White"
                     WidthRequest="150"
                     HeightRequest="150"
                     HorizontalOptions="Start"
                     VerticalOptions="End"
                     Margin="-75,0,0,-75"
                     Opacity="0.15"/>
            <Ellipse Fill="#E31D26"
                     WidthRequest="100"
                     HeightRequest="100"
                     HorizontalOptions="Start"
                     VerticalOptions="End"
                     Margin="-50,0,0,-50"
                     Opacity="0.35"/>

            <!-- Trama de grano de fanzine sutil al 3% para unificar la textura de la Agenda -->
            <Grid BackgroundColor="Transparent"
                  Opacity="0.03">
                <BoxView Color="White"
                         VerticalOptions="Fill"
                         HorizontalOptions="Fill"/>
            </Grid>
        </Grid>



        <!-- ==================== CAPA DEL CONTENIDO PRINCIPAL ==================== -->
        <Grid RowDefinitions="Auto, Auto, Auto, *"
              Padding="20">

            <!-- 1. PESTAÑAS DE NAVEGACIÓN SUPERIORES -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto, Auto"
                  Margin="15,0,0,15"
                  HorizontalOptions="Start">
                <Border x:Name="TabAgenda"
                        Grid.Column="0"
                        BackgroundColor="#E5E5E5"
                        Stroke="Black"
                        StrokeThickness="1.5"
                        Rotation="-4"
                        ZIndex="1"
                        Padding="30,12">
                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Offset="4,4"
                                Radius="0"
                                Opacity="0.5"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAgendaTabTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="AGENDA"
                           TextColor="#222222"
                           FontSize="21"
                           FontFamily="Impact"/>
                </Border>
                <Border x:Name="TabCalendario"
                        Grid.Column="1"
                        BackgroundColor="Black"
                        Stroke="White"
                        StrokeThickness="2"
                        Rotation="3"
                        ZIndex="2"
                        Margin="-25,2,0,0"
                        Padding="35,12">
                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Offset="5,5"
                                Radius="0"
                                Opacity="0.8"/>
                    </Border.Shadow>
                    <Label Text="CALENDARIO"
                           TextColor="#E31D26"
                           FontSize="21"
                           FontFamily="Impact"/>
                </Border>
            </Grid>

            <!-- 2. CABECERA HUD EXTIDILO PHANTOM THIEVES (REDISEÑO TOTAL AGRESIVO) -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto, *, Auto"
                  Margin="10,5,10,20"
                  VerticalOptions="Center">

                <!-- BOTÓN MES ANTERIOR: Machetazo Diagonal Masivo estilo Navaja -->
                <Grid Grid.Column="0"
                      WidthRequest="55"
                      HeightRequest="50"
                      Rotation="-12"
                      VerticalOptions="Center">
                    <!-- Sombra sólida negra -->
                    <Polygon Points="8,10 55,0 42,50 0,40"
                             Fill="Black"
                             Aspect="Fill"/>
                    <!-- Bloque Rojo Delantero súper afilado -->
                    <Polygon Points="3,5 50,-5 37,45 0,35"
                             Fill="#E31D26"
                             Stroke="White"
                             StrokeThickness="1.5"
                             Aspect="Fill"/>
                    <Label Text="&lt;"
                           TextColor="White"
                           FontFamily="Impact"
                           FontSize="26"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="-4,-2,0,0"/>
                    <Button Clicked="OnPrevMonthClicked"
                            BackgroundColor="Transparent"
                            CornerRadius="0"
                            ZIndex="2"/>
                </Grid>

                <!-- HUD CENTRAL: REPLICA DE PANTALLA DE DÍA REAL DE P5 (ESTILO COLLAGE COMPACTO) -->
                <Grid Grid.Column="1"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      WidthRequest="360"
                      HeightRequest="180"
                      Margin="0,-30,0,-10">

                    <!-- CAPA 1: EL AÑO (Arriba a la Izquierda, Masivo) -->
                    <!-- Actúa como el dígito dominante con rotación agresiva hacia la izquierda -->
                    <FlexLayout x:Name="ContenedorLetrasAnio"
                                Direction="Row"
                                JustifyContent="Center"
                                AlignItems="Center"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                HeightRequest="70"
                                Rotation="-15"
                                Margin="30,5,0,0"
                                ZIndex="2"/>


                    <!-- CAPA 2: EL MES (Abajo a la Derecha - CALIBRADO PREMIUM AL PÍXEL) -->
                    <Grid HorizontalOptions="End"
                          VerticalOptions="End"
                          WidthRequest="430"
                          HeightRequest="75"
                          Rotation="8"
                          Margin="0,0,10,10"
                          ZIndex="3">

                        <!-- Sombra trasera asimétrica ampliada -->
                        <Polygon Points="3,0 433,0 425,100 -2,100"
                                 Fill="Black"
                                 Aspect="Fill"
                                 ZIndex="1"/>

                        <!-- Polígono Delantero Negro con Borde Rojo Fuego ampliado -->
                        <Polygon Points="0,0 430,0 422,100 6,100"
                                 Fill="Black"
                                 Stroke="#E31D26"
                                 StrokeThickness="3.5"
                                 Aspect="Fill"
                                 ZIndex="2"/>

                        <!-- RE TOQUE CRÍTICO: Cambiamos a Margin="15,0,15,4" para centrar el collage perfectamente -->
                        <FlexLayout x:Name="ContenedorLetrasMes"
                                    Direction="Row"
                                    JustifyContent="Center"
                                    AlignItems="Center"
                                    Margin="15,0,15,4"
                                    ZIndex="3"/>
                    </Grid>

                    <!-- CAPA 3: DETALLE URBANO (Cinta de sujeción punk sobre el Año) -->
                    <Polygon Points="0,0 35,-5 25,15 -5,17"
                             Fill="Black"
                             HorizontalOptions="Start"
                             VerticalOptions="Start"
                             Margin="20,0,0,0"
                             Rotation="-40"
                             ZIndex="4"/>
                </Grid>


                <!-- BOTÓN MES SIGUIENTE: Machetazo Diagonal Inverso -->
                <Grid Grid.Column="2"
                      WidthRequest="55"
                      HeightRequest="50"
                      Rotation="14"
                      VerticalOptions="Center">
                    <!-- Sombra sólida negra -->
                    <Polygon Points="0,10 47,0 55,40 13,50"
                             Fill="Black"
                             Aspect="Fill"/>
                    <!-- Bloque Rojo Delantero súper afilado -->
                    <Polygon Points="0,5 47,-5 55,35 13,45"
                             Fill="#E31D26"
                             Stroke="White"
                             StrokeThickness="1.5"
                             Aspect="Fill"/>
                    <Label Text="&gt;"
                           TextColor="White"
                           FontFamily="Impact"
                           FontSize="26"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="4,-2,0,0"/>
                    <Button Clicked="OnNextMonthClicked"
                            BackgroundColor="Transparent"
                            CornerRadius="0"
                            ZIndex="2"/>
                </Grid>

            </Grid>

            <!-- ==================== 3. INDICADORES DE DÍAS DE LA SEMANA (FILA 2 - COLLAGE LIBRE PREMIUM) ==================== -->
            <Grid Grid.Row="2"
                  HeightRequest="70"
                  Margin="15,5,15,5"
                  VerticalOptions="Center">

                <!-- Franja roja de peligro continua (Base de contraste duro) -->
                <BoxView Color="#E31D26"
                         HeightRequest="26"
                         VerticalOptions="Center"
                         Rotation="-0.5"
                         ZIndex="1"/>

                <!-- CAPA TIPOGRÁFICA: Un contenedor elástico que permite desalineaciones y escalas caóticas -->
                <FlexLayout ZIndex="2"
                            Direction="Row"
                            JustifyContent="SpaceAround"
                            AlignItems="Center"
                            VerticalOptions="Fill"
                            HorizontalOptions="Fill"
                            Margin="5,0">

                    <!-- LUNES: Tarjeta Blanca Rectangular Estrecha y Alta (Letra se come el papel) -->
                    <Border BackgroundColor="White"
                            Stroke="Black"
                            StrokeThickness="2.5"
                            StrokeShape="Rectangle"
                            Padding="12,2,12,4"
                            HeightRequest="46"
                            VerticalOptions="Center"
                            ZIndex="2">
                        <Label Text="L"
                                FontFamily="Impact"
                                FontSize="26"
                                TextColor="Black"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                    </Border>

                    <!-- MARTES: Tarjeta Negra Cuadrada Pequeña (Asimetría radical de escala) -->
                    <Border BackgroundColor="Black"
                            StrokeThickness="0"
                            StrokeShape="Rectangle"
                            Padding="8,4"
                            HeightRequest="32"
                            VerticalOptions="Center"
                            ZIndex="2"
                            TranslationY="-6">
                        <Label Text="M"
                                FontFamily="Franklin Gothic"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                    </Border>

                    <!-- MIÉRCOLES: Letra Blanca Gigante Suelta con Sombra Sólida Negra (Sin papel trasero) -->
                    <Grid VerticalOptions="Center"
                            ZIndex="2"
                            HeightRequest="45"
                            TranslationY="4">
                        <Label Text="X"
                                FontFamily="Impact"
                                FontSize="34"
                                TextColor="Black"
                                Margin="3,3,0,0"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                        <Label Text="X"
                                FontFamily="Impact"
                                FontSize="34"
                                TextColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                    </Grid>

                    <!-- JUEVES: Tarjeta Negra Alargada con Contorno Blanco Fino -->
                    <Border BackgroundColor="Black"
                            Stroke="White"
                            StrokeThickness="1.5"
                            StrokeShape="Rectangle"
                            Padding="14,6,14,2"
                            HeightRequest="42"
                            VerticalOptions="Center"
                            ZIndex="2"
                            TranslationY="-3">
                        <Label Text="J"
                                FontFamily="Franklin Gothic"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                    </Border>

                    <!-- VIERNES: Tarjeta Blanca Apelotonada Transversal -->
                    <Border BackgroundColor="White"
                            Stroke="Black"
                            StrokeThickness="2"
                            StrokeShape="Rectangle"
                            Padding="10,4"
                            HeightRequest="38"
                            VerticalOptions="Center"
                            ZIndex="2"
                            TranslationY="5">
                        <Label Text="V"
                                FontFamily="Impact"
                                FontSize="24"
                                TextColor="Black"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                    </Border>

                    <!-- SÁBADO: Fin de Semana - Tarjeta Negra con Borde de Alerta Rojo Fuego -->
                    <Border BackgroundColor="Black"
                            Stroke="#E31D26"
                            StrokeThickness="3"
                            StrokeShape="Rectangle"
                            Padding="12,5"
                            HeightRequest="44"
                            VerticalOptions="Center"
                            ZIndex="2"
                            TranslationY="-2">
                        <Label Text="S"
                                FontFamily="Impact"
                                FontSize="24"
                                TextColor="#E31D26"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                    </Border>

                    <!-- DOMINGO: Peligro Crítico - Tarjeta Roja Fuego con contorno Negro Grueso y Letra Blanca Masiva -->
                    <Border BackgroundColor="#E31D26"
                            Stroke="Black"
                            StrokeThickness="3"
                            StrokeShape="Rectangle"
                            Padding="16,3"
                            HeightRequest="50"
                            VerticalOptions="Center"
                            ZIndex="3"
                            TranslationY="6">
                        <Label Text="D"
                                FontFamily="Impact"
                                FontSize="30"
                                TextColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                    </Border>
                </FlexLayout>
            </Grid>




            <!-- ==================== 4. MATRIZ DE CALENDARIO: SISTEMA DE TARJETAS BLINDADO (FILA 3) ==================== -->
            <CollectionView Grid.Row="3"
                            ItemsSource="{Binding DiasDelMes}"
                            Margin="15,0,15,10">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="7"
                                     HorizontalItemSpacing="14"
                                     VerticalItemSpacing="16"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DiaCalendario">
                        <!-- Celda base conectada a la rotación individual orgánica de tu modelo -->
                        <Grid HeightRequest="65"
                              WidthRequest="55"
                              Rotation="{Binding RotacionCelda}"
                              HorizontalOptions="Center"
                              VerticalOptions="Center">

                            <!-- 1. SOMBRA TRASERA ASIMÉTRICA NEGRA: Se mantiene SIEMPRE visible para dar relieve -->
                            <Border BackgroundColor="Black"
                                    StrokeThickness="0"
                                    StrokeShape="Polygon 3,0 53,4 48,60 -2,56"
                                    Margin="4,4,-4,-4"
                                    ZIndex="1"/>

                            <!-- 2. CONTENEDOR DELANTERO REAL: Blanco por defecto / Muta a Rojo si es Hoy -->
                            <!-- Conservamos el contorno negro nativo ("Stroke") para que no pierda definición -->
                            <Border x:Name="TarjetaBase"
                                    BackgroundColor="White"
                                    Stroke="Black"
                                    StrokeThickness="2"
                                    StrokeShape="Polygon 0,0 50,4 45,58 2,54"
                                    ZIndex="2">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding EsHoy}"
                                                 Value="True">
                                        <!-- RETOQUE: Cambia el fondo a rojo pero preserva el contorno negro marcado de fanzine -->
                                        <Setter Property="BackgroundColor"
                                                Value="#E31D26"/>
                                        <Setter Property="Stroke"
                                                Value="Black"/>
                                        <Setter Property="StrokeThickness"
                                                Value="2.5"/>
                                        <!-- Un pelo más grueso para marcar el día -->
                                    </DataTrigger>
                                </Border.Triggers>

                                <!-- Grid interno que fuerza la separación física de las capas -->
                                <Grid RowDefinitions="18, *">

                                    <!-- 3. PESTAÑA SUPERIOR DE RE CORTE NEGRO: Se mantiene SIEMPRE negra para dar consistencia -->
                                    <BoxView Grid.Row="0"
                                             Color="Black"
                                             VerticalOptions="Fill"
                                             HorizontalOptions="Fill"/>

                                    <!-- 4. TEXTO DEL NÚMERO: Atrapado en primer plano seguro -->
                                    <Label Grid.Row="1"
                                           Text="{Binding NumeroDia}"
                                           FontFamily="Franklin Gothic"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="Black"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Margin="0,0,0,2"
                                           ZIndex="99">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding EsMesActual}"
                                                         Value="True">
                                                <Setter Property="Opacity"
                                                        Value="1.0"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding EsMesActual}"
                                                         Value="False">
                                                <Setter Property="TextColor"
                                                        Value="#A0A0A0"/>
                                                <Setter Property="Opacity"
                                                        Value="0.15"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding EsHoy}"
                                                         Value="True">
                                                <!-- Si es hoy, el número resalta en Blanco Puro sobre el fondo rojo -->
                                                <Setter Property="TextColor"
                                                        Value="White"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </Grid>
</ContentPage>
